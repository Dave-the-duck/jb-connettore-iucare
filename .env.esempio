# Variabili d'ambiente del connettore JB → IUCARE.
# Copia questo file in ".env" (stessa cartella) e riempi i valori veri.
# Il file ".env" NON va su GitHub: contiene chiavi segrete (lo esclude .gitignore).

# Chiave segreta per l'IMPRONTA del codice fiscale.
# DEVE essere identica a quella dell'app IUCARE (iucare/.env.local -> IUCARE_CF_SECRET),
# altrimenti le impronte non combaciano e nessun esame viene abbinato.
IUCARE_CF_SECRET=

# Indirizzo del progetto Supabase (lo stesso NEXT_PUBLIC_SUPABASE_URL dell'app).
# Esempio: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Chiave "service role" di Supabase (Project Settings -> API -> service_role).
# ATTENZIONE: è potentissima (scavalca le protezioni). Solo qui nel connettore,
# mai nell'app, mai nel browser, mai su GitHub.
SUPABASE_SERVICE_ROLE_KEY=
